# SQLAlchemy/psycopg connection string for the application database (postgres:// and postgresql:// are normalized).
DATABASE_URL=postgresql+psycopg://localhost/prediction_desk
# Trading mode; only "paper" is accepted, anything else fails at startup.
TRADING_MODE=paper
# Training cutoff date of the LLM in use (YYYY-MM-DD); markets resolving before it are treated as leakage-prone.
LLM_TRAINING_CUTOFF=2026-01-01
# Admin connection used by the test suite to create and drop throwaway databases.
TEST_DATABASE_ADMIN_URL=postgresql+psycopg://localhost/postgres
# FRED API key (free): create one at https://fredaccount.stlouisfed.org/apikeys
FRED_API_KEY=
# Alpha Vantage API key (free tier: 25 calls/day): https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=
